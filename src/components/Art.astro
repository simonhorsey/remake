---
// Simple original line illustrations, one per showcase item.
const { kind = 'steps' } = Astro.props;
---
<svg class="art" viewBox="0 0 480 360" role="img" aria-hidden="true" preserveAspectRatio="xMidYMid slice">
  <rect width="480" height="360" fill="#01305a" />
  <g fill="none" stroke="#0b4877" stroke-width="1">
    {Array.from({ length: 9 }).map((_, i) => <line x1={i * 60} y1="0" x2={i * 60} y2="360" />)}
    {Array.from({ length: 7 }).map((_, i) => <line x1="0" y1={i * 60} x2="480" y2={i * 60} />)}
  </g>
  {kind === 'steps' && (
    <g>
      <path d="M60 300h90v-60h90v-60h90v-60h90" fill="none" stroke="#f57e2c" stroke-width="8" stroke-linecap="round" stroke-linejoin="round" />
      <circle cx="420" cy="120" r="16" fill="#f57e2c" />
      <path d="M60 300h90v-60h90v-60h90v-60h90V300z" fill="#f57e2c" opacity="0.12" />
      <g fill="#ffffff"><circle cx="105" cy="300" r="7" /><circle cx="195" cy="240" r="7" /><circle cx="285" cy="180" r="7" /><circle cx="375" cy="120" r="7" /></g>
    </g>
  )}
  {kind === 'calendar' && (
    <g>
      <rect x="90" y="70" width="300" height="230" rx="18" fill="#ffffff" />
      <rect x="90" y="70" width="300" height="52" rx="18" fill="#f57e2c" />
      <rect x="90" y="100" width="300" height="22" fill="#f57e2c" />
      {[0, 1, 2].map((r) => [0, 1, 2, 3, 4].map((c) => {
        const on = (r * 5 + c) % 3 === 0; const mid = (r * 5 + c) % 3 === 1;
        return <rect x={112 + c * 54} y={142 + r * 50} width="40" height="34" rx="8" fill={on ? '#91b5d3' : mid ? '#f57e2c' : '#d6e0ea'} />;
      }))}
    </g>
  )}
  {kind === 'guide' && (
    <g>
      <rect x="150" y="50" width="200" height="268" rx="12" fill="#91b5d3" transform="rotate(6 250 184)" />
      <rect x="140" y="46" width="200" height="268" rx="12" fill="#ffffff" />
      <rect x="162" y="76" width="96" height="12" rx="6" fill="#f57e2c" />
      <rect x="162" y="104" width="156" height="16" rx="6" fill="#002442" />
      <rect x="162" y="128" width="120" height="16" rx="6" fill="#002442" />
      <g fill="#c5d3e0"><rect x="162" y="176" width="156" height="8" rx="4" /><rect x="162" y="196" width="140" height="8" rx="4" /><rect x="162" y="216" width="150" height="8" rx="4" /><rect x="162" y="236" width="110" height="8" rx="4" /></g>
      <circle cx="300" cy="278" r="18" fill="#f57e2c" />
    </g>
  )}
  {kind === 'school' && (
    <g>
      <path d="M240 70l150 70H90z" fill="#f57e2c" />
      <rect x="110" y="140" width="260" height="150" fill="#ffffff" />
      <g fill="#91b5d3"><rect x="136" y="168" width="40" height="46" rx="4" /><rect x="304" y="168" width="40" height="46" rx="4" /></g>
      <rect x="212" y="200" width="56" height="90" rx="6" fill="#002442" />
      <rect x="80" y="290" width="320" height="14" rx="4" fill="#f57e2c" />
      <circle cx="240" cy="108" r="12" fill="#002442" />
    </g>
  )}
  {kind === 'guideperson' && (
    <g>
      <circle cx="240" cy="140" r="56" fill="#ffffff" />
      <path d="M130 320c0-66 49-106 110-106s110 40 110 106z" fill="#91b5d3" />
      <path d="M350 96l34-34M372 118h44M328 74V30" stroke="#f57e2c" stroke-width="8" stroke-linecap="round" />
    </g>
  )}
</svg>
<style>
  .art { width: 100%; height: 100%; object-fit: cover; }
</style>
