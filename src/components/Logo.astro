---
const { href = '/' } = Astro.props;
---
<a class="logo" href={href} aria-label="LearningForSuccess home">
  <svg class="logo__mark" viewBox="0 0 40 40" width="36" height="36" aria-hidden="true">
    <rect width="40" height="40" rx="10" fill="#ffb703" />
    <path d="M8 30h7v-6h7v-6h7v-6h4" fill="none" stroke="#0d1b2a" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round" />
    <circle cx="33" cy="12" r="2.6" fill="#0d1b2a" />
  </svg>
  <span class="logo__text">Learning<b>ForSuccess</b></span>
</a>
<style>
  .logo { display: inline-flex; align-items: center; gap: 0.6rem; text-decoration: none; color: inherit; }
  .logo__mark { flex: none; }
  .logo__text { font-family: var(--font-display); font-size: 1.2rem; font-weight: 400; letter-spacing: -0.01em; white-space: nowrap; }
  .logo__text b { font-weight: 800; }
  @media (max-width: 380px) { .logo__text { font-size: 1.05rem; } }
</style>
