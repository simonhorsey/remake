---
// The Essentials For Learning logo. `light` uses the full-colour version for
// pale backgrounds; the default is the white version for the dark header and footer.
const { href = '/', light = false } = Astro.props;
---
<a class="logo" href={href} aria-label="Essentials For Learning home">
  <img src={light ? '/brand/logo.svg' : '/brand/logo-white.svg'} alt="Essentials For Learning" width="196" height="60" />
</a>
<style>
  .logo { display: inline-flex; align-items: center; text-decoration: none; padding-block: 6px; }
  .logo img { height: 60px; width: auto; }
  @media (max-width: 420px) { .logo img { height: 48px; } }
</style>
