---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found | LearningForSuccess" noindex>
  <section class="page-hero" data-section="hero">
    <div class="wrap">
      <p class="eyebrow" style="color: var(--accent)">404</p>
      <h1>That Page Has Gone Missing</h1>
      <p class="lede">The link may be old or mistyped. Here is the way back.</p>
      <div class="page-hero__actions">
        <a class="btn" href="/">Back to the Home Page</a>
        <a class="btn btn--ghost" href="/#paths">Choose Your Course</a>
      </div>
    </div>
  </section>
</Base>
