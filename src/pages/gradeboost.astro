---
import Base from '../layouts/Base.astro';
import Offer from '../components/Offer.astro';
import { courses } from '../content/site.js';
const c = courses['gradeboost'];
const cta = c.enrolUrl
  ? { label: 'Enrol Now', href: c.enrolUrl }
  : { label: 'Join the Waiting List', href: `/contact/?about=${c.slug}`, soon: true };
---
<Base title={c.title} description={c.description}>
  <Offer
    audience={c.audience}
    heading={c.heading}
    lead={c.lead}
    price={c.price}
    showPrice={Boolean(c.enrolUrl)}
    cta={cta}
    stakes={c.stakes}
    offer={c.learn}
    steps={c.steps}
    faqs={c.faqs}
    closing={c.closing}
  />
</Base>
